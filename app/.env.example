# GlobalTrade Hub — environment variables
# Copy to .env.local and fill in what you need. The app runs fully WITHOUT any of
# these (simulated market data + local paper engine + heuristic coach).

# ---------------------------------------------------------------------------
# Super-admin auth. Set ALL THREE, or NONE of them.
#   none  -> open demo mode, no authentication at all
#   all   -> the app is gated behind these credentials
#   some  -> the app refuses to serve (503) rather than silently running open
# AUTH_SECRET has no default: without it, sessions could not be signed safely.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me
AUTH_SECRET=generate-a-long-random-string   # e.g. `openssl rand -hex 32`
ADMIN_USER_ID=            # optional UUID used as owner for Supabase rows

# ---------------------------------------------------------------------------
# AI — multi-provider LLM. DeepSeek is the default. Set at least one key.
# ---------------------------------------------------------------------------
LLM_PROVIDER=deepseek          # deepseek | openai | gemini | anthropic
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---------------------------------------------------------------------------
# Market data
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ENABLE_BINANCE_FEED=true    # real crypto via Binance public WS; 'false' = pure sim
MARKETDATA_PROVIDER=twelvedata          # FX/commodity provider (see docs/PROVIDERS.md)
MARKETDATA_API_KEY=

# ---------------------------------------------------------------------------
# Supabase (auth + persistence). Create a DEDICATED project (see README).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=              # server-only; also enables Vault-backed broker secrets

# ---------------------------------------------------------------------------
# Notifications (priority: Telegram -> Email -> WhatsApp). See docs/PROVIDERS.md.
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=
EMAIL_FROM=alerts@yourdomain.com
EMAIL_TO=you@example.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_TO=whatsapp:+91XXXXXXXXXX

# ---------------------------------------------------------------------------
# Scheduling — secures GET /api/cron/tick (Vercel Cron / Supabase pg_cron)
# ---------------------------------------------------------------------------
CRON_SECRET=

# ---------------------------------------------------------------------------
# Brokers. Keys can be entered in-app (Settings -> Connections) OR set here as a
# server-side fallback. Either way they are verified against the venue before use
# and stored in Supabase Vault — never sent to the browser.
# ---------------------------------------------------------------------------
# Real-money routing is refused unless this is exactly 'true'.
ENABLE_LIVE_TRADING=false

# Alpaca (US equities). Paper and live use DIFFERENT keys.
ALPACA_PAPER_TRADING_API_KEY=
ALPACA_PAPER_TRADING_SECRET_KEY=

# Binance (crypto). Paper mode targets the Spot Testnet, which issues its own keys
# at testnet.binance.vision — mainnet keys will NOT authenticate there.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Dhan (India) has no sandbox, so it is live-only. It needs a clientId + accessToken
# entered in Settings; DHANHQ_API_KEY/_SECRET are partner credentials and are not used.

# Historical candles come from Binance (free), Alpaca (keys above) and Twelve Data.
# FINNHUB_API_KEY / ALPHA_VANTAGE_API_KEY are not wired to anything yet.